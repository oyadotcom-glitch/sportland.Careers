# מפתח ה-API של SendGrid (https://sendgrid.com) לשליחת מיילים דרך HTTPS.
# חשבון חינמי נותן עד 100 מיילים ביום - מספיק בהרבה למועמדויות.
# למה SendGrid ולא SMTP רגיל? הרבה שירותי אחסון ענן (כולל Railway) חוסמים/נתקלים
# בבעיות עם חיבורי SMTP ישירים (פורטים 587/465) - API מבוסס HTTPS עוקף את זה.
SENDGRID_API_KEY=SG.your_api_key_here

# כתובת השולח - חייבת להיות כתובת שאומתה ב-SendGrid דרך
# Settings > Sender Authentication > Single Sender Verification
# (שולחים מייל אימות לכתובת, לוחצים על הלינק - בלי צורך בגישה ל-DNS).
MAIL_FROM="SPORTLAND - גיוס עובדים" <resume.csport@gmail.com>

# פורט להרצת השרת (אופציונלי, ברירת מחדל 3000)
PORT=3000

# אופציונלי: דריסת כתובות המייל של הסניפים בלי לגעת בקוד (server/config.js)
# EMAIL_HADERA=Danny@csport.co.il
# EMAIL_BEIT_YITZHAK=Ronit@csport.co.il
# EMAIL_TIVON=tamara@csport-tivon.co.il
