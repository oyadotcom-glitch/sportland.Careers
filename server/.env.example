# מפתח ה-API של Resend (https://resend.com) לשליחת מיילים דרך HTTPS.
# חשבון חינמי ב-Resend נותן עד 3,000 מיילים בחודש / 100 ביום - מספיק בהרבה למועמדויות.
# למה Resend ולא SMTP רגיל? הרבה שירותי אחסון ענן (כולל Railway) חוסמים/נתקלים
# בבעיות עם חיבורי SMTP ישירים (פורטים 587/465) - API מבוסס HTTPS עוקף את זה.
RESEND_API_KEY=re_your_api_key_here

# כתובת השולח שתופיע במייל היוצא.
# בלי אימות דומיין ב-Resend צריך להשתמש בדומיין הבדיקה שלהם:
MAIL_FROM="SPORTLAND - גיוס עובדים" <onboarding@resend.dev>
# לאחר אימות דומיין משלכם ב-Resend (Settings > Domains), אפשר להחליף לכתובת עם הדומיין של החברה, לדוגמה:
# MAIL_FROM="SPORTLAND - גיוס עובדים" <jobs@sportland.co.il>

# פורט להרצת השרת (אופציונלי, ברירת מחדל 3000)
PORT=3000

# אופציונלי: דריסת כתובות המייל של הסניפים בלי לגעת בקוד (server/config.js)
# EMAIL_HADERA=Danny@csport.co.il
# EMAIL_BEIT_YITZHAK=Ronit@csport.co.il
# EMAIL_TIVON=tamara@csport-tivon.co.il
