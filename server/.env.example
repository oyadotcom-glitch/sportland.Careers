# מפתח ה-API של Brevo (https://brevo.com) לשליחת מיילים דרך HTTPS.
# חשבון חינמי נותן עד 300 מיילים ביום - חינם לצמיתות, בלי הגבלת זמן.
# למה Brevo ולא SMTP רגיל? הרבה שירותי אחסון ענן (כולל Railway) חוסמים/נתקלים
# בבעיות עם חיבורי SMTP ישירים (פורטים 587/465) - API מבוסס HTTPS עוקף את זה.
BREVO_API_KEY=xkeysib-your_api_key_here

# כתובת השולח - חייבת להיות כתובת שאומתה ב-Brevo (Senders, Domains & Dedicated IPs
# > Senders > Add a Sender) - שולחים קוד בן 6 ספרות לכתובת ומזינים אותו, בלי צורך ב-DNS.
MAIL_FROM="SPORTLAND - גיוס עובדים" <resume.csport@gmail.com>

# פורט להרצת השרת (אופציונלי, ברירת מחדל 3000)
PORT=3000

# אופציונלי: דריסת כתובות המייל של הסניפים בלי לגעת בקוד (server/config.js)
# EMAIL_HADERA=Danny@csport.co.il
# EMAIL_BEIT_YITZHAK=Ronit@csport.co.il
# EMAIL_TIVON=tamara@csport-tivon.co.il
